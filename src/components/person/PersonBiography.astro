---
import type { ParsedBiographyEntry } from "../../lib/parsePersonBody";

interface Props {
  entries: ParsedBiographyEntry[];

  /** 是否為演義生平（要顯示「與史實的差異」區塊） */
  isRomance?: boolean;
}

const { entries, isRomance = false } = Astro.props;
---

<ol
  class:list={[
    "person-biography-list",
    { "person-biography-list--romance": isRomance },
  ]}
>
  {
    entries.map((entry) => (
      <li class="person-biography-entry">
        <div class="person-biography-entry__track" aria-hidden="true">
          <span />
        </div>

        <article class="person-biography-entry__content">
          <div class="person-biography-entry__meta">
            <span class="person-biography-entry__period">{entry.period}</span>
          </div>

          <h4>{entry.title}</h4>

          <div class="person-overview__prose">
            {entry.paragraphs.map((paragraph) => (
              <>
                <p>{paragraph.text}</p>

                {paragraph.citations.length > 0 && (
                  <ul class="person-rank-list__sources person-paragraph-citations">
                    {paragraph.citations.map((citation) => (
                      <li>
                        {citation.source}
                        {citation.locator && <small>{citation.locator}</small>}
                      </li>
                    ))}
                  </ul>
                )}
              </>
            ))}
          </div>

          {entry.uncertaintyNote && (
            <aside class="person-overview__notice">
              <strong>年代備註</strong>
              <p>{entry.uncertaintyNote}</p>
            </aside>
          )}

          {entry.originalTexts.length > 0 && (
            <details class="person-biography-entry__original">
              <summary>展開原文</summary>
              {entry.originalTexts.map((original) => (
                <>
                  <p>{original.text}</p>

                  {original.citations.length > 0 && (
                    <ul class="person-rank-list__sources person-paragraph-citations">
                      {original.citations.map((citation) => (
                        <li>
                          {citation.source}
                          {citation.locator && <small>{citation.locator}</small>}
                        </li>
                      ))}
                    </ul>
                  )}
                </>
              ))}
            </details>
          )}

          {isRomance && entry.historicalDifference && entry.historicalDifference.length > 0 && (
            <aside class="person-overview__notice person-biography-entry__difference">
              <strong>與史實的差異</strong>

              {entry.historicalDifference.map((paragraph) => (
                <>
                  <p>{paragraph.text}</p>

                  {paragraph.citations.length > 0 && (
                    <ul class="person-rank-list__sources person-paragraph-citations">
                      {paragraph.citations.map((citation) => (
                        <li>
                          {citation.source}
                          {citation.locator && <small>{citation.locator}</small>}
                        </li>
                      ))}
                    </ul>
                  )}
                </>
              ))}
            </aside>
          )}
        </article>
      </li>
    ))
  }
</ol>