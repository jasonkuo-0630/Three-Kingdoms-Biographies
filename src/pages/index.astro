---
import {
  getCollection,
  type CollectionEntry,
} from "astro:content";

import SiteHeader from "../components/SiteHeader.astro";
import HomeHero from "../components/HomeHero.astro";

import "../styles/home-hero.css";

interface SearchPersonData {
  slug: string;
  name: string;
  courtesyName?: string;
  avatar: string;
}

/**
 * GitHub Pages 部署時，網站位於：
 * /Three-Kingdoms-Biographies/
 *
 * 使用 BASE_URL 可以讓本機與 GitHub Pages
 * 自動使用正確的圖片及連結路徑。
 */
const base = import.meta.env.BASE_URL.replace(
  /\/?$/,
  "/",
);

/**
 * 自動取得全站人物搜尋名單。
 *
 * 改讀 src/content/people/*.md（content collection），
 * 不再是暫時留空的陣列，新增人物資料後會自動出現在搜尋結果裡。
 */
const allPeople: CollectionEntry<"people">[] =
  await getCollection("people");

const searchPeople: SearchPersonData[] = allPeople.map(
  (person: CollectionEntry<"people">) => ({
    slug: person.data.id,
    name: person.data.name,
    courtesyName: person.data.courtesyName,
    avatar: person.data.avatar,
  }),
);
---

<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>三國人物誌</title>

    <!-- 網站品牌圖示 -->
    <link
      rel="icon"
      type="image/svg+xml"
      href={`${base}favicon.svg`}
    />

    <link
      rel="icon"
      href={`${base}favicon.ico`}
    />

    <!-- 網站字型 -->
    <link
      rel="preconnect"
      href="https://fonts.googleapis.com"
    />

    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />

    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&family=Noto+Serif+TC:wght@600;700;900&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="home-page">
    <SiteHeader
      showSearch={true}
      searchPeople={searchPeople}
      referenceLibraryUrl=""
    />

    <main>
      <HomeHero />
    </main>
  </body>
</html>

<style is:global>
  .home-page {
    min-height: 100vh;
    background: #201b17;
  }

  .home-page main {
    min-height: calc(100vh - 86px);
  }
</style>